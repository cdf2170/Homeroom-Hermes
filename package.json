{
  "name": "homeroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @homeroom/service dev & pnpm --filter @homeroom/web dev & wait",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-types": "pnpm -r check-types",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @homeroom/service db:generate",
    "db:migrate": "pnpm --filter @homeroom/service db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.2"
  }
}
