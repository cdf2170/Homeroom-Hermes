{
  "name": "@homeroom/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.2",
    "@homeroom/adapter-core": "workspace:*",
    "@homeroom/adapter-openclaw": "workspace:*",
    "@homeroom/contracts": "workspace:*",
    "@homeroom/domain": "workspace:*",
    "@homeroom/schemas": "workspace:*",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.40.1",
    "fastify": "^5.3.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
